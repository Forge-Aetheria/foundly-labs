# Foundly Book — environment (SPA, feature 024)
# Copy to `.env`; values are per-environment and never committed.
# See specs/architecture.md §3.1 and specs/book/024-react-spa-migration/contracts/.

# GraphQL base URL of the Foundly API (public; shipped in the browser bundle)
VITE_API_URL=http://localhost:3002

# Supabase Auth — public project values (session persisted in localStorage)
# Vite only exposes VITE_* variables. NEXT_PUBLIC_* names from the old Next.js app are ignored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional request timeout (ms); defaults to 10000
# VITE_API_REQUEST_TIMEOUT_MS=10000

# NOTE: privileged secrets (SUPABASE_SERVICE_ROLE_KEY) live ONLY in apps/api.
# The onboarding tenant binding runs server-side via the `registerBusiness` mutation.
