# Foundly Book — environment (copy to .env; values are per-environment, never committed)
# See specs/architecture.md §3.1 and specs/book/008-api-integration-catalog-sync/contracts/api-connectivity.contract.md

# GraphQL base URL of the Foundly API (server-side reads/writes; no secret)
API_URL=http://localhost:3002

# Optional client-side diagnostic URL (health indicator). Not required for operation.
# NEXT_PUBLIC_API_URL=http://localhost:3002

# Supabase Auth — public project values (NEXT_PUBLIC_* so both server and browser read them)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY — SECRET, SERVER-ONLY. Used by the onboarding action to bind
# tenant_id into app_metadata (auth.admin.updateUserById). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Auth modes (feature 009 — specs/book/009-admin-auth):
# - LIVE: when NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY are set, /login signs in
#   against Supabase Auth (signInWithPassword) and the session lives in Supabase cookies.
# - LOCAL (default when unset): a minimal dev seam authenticates against the in-memory store and
#   sets an httpOnly cookie. Seeded dev owner: ana@foundly.dev / mock-credential.
# No additional variables are required for admin authentication.