---
import Badge from '@/shared/components/ui/Badge.astro';
import type { Application } from '@/shared/types';

interface Props {
  app: Application;
}

type StatusTone = 'positive' | 'warning' | 'active';

const { app } = Astro.props;

const imageSrc = app.icon || app.logo;
const toggleId = `expand-${app.id}`;

const resolveStatusTone = (status: string): StatusTone => {
  const value = status.toLowerCase();
  if (value.includes('producc') || value.includes('disponible')) return 'positive';
  if (value.includes('beta')) return 'active';
  return 'warning';
};

const statusTone: StatusTone = resolveStatusTone(app.status);

const statusToneClass: Record<StatusTone, string> = {
  positive: 'bg-status-positive-bg text-status-positive-text',
  warning: 'bg-status-warning-bg text-status-warning-text',
  active: 'bg-status-active-bg text-status-active-text',
};

const floatingClasses = [
  'group-hover:absolute group-hover:inset-x-0 group-hover:top-0 group-hover:z-30 group-hover:-translate-y-1',
  'group-hover:border-border-lavender group-hover:shadow-2xl group-hover:shadow-accent-primary/20',
  'group-has-[:checked]:absolute group-has-[:checked]:inset-x-0 group-has-[:checked]:top-0 group-has-[:checked]:z-30 group-has-[:checked]:-translate-y-1',
  'group-has-[:checked]:border-border-lavender group-has-[:checked]:shadow-2xl group-has-[:checked]:shadow-accent-primary/20',
].join(' ');
---

<div class="group relative min-h-[380px] hover:z-30 has-[:checked]:z-30">
  <article
    class={`bg-card-light/60 border-border-subtle shadow-card has-[:focus-visible]:ring-accent-primary relative w-full min-h-[380px] rounded-2xl border p-6 backdrop-blur-md transition-all duration-300 ease-in-out has-[:focus-visible]:ring-2 ${floatingClasses}`}
  >
    <input
      id={toggleId}
      type="checkbox"
      class="peer sr-only"
      aria-label={`Mostrar más sobre ${app.name}`}
    />

    <header class="relative z-10 flex items-start gap-3">
      <span class="bg-surface-elevated border-border-subtle shadow-sm flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border">
        <img
          src={imageSrc}
          alt={`Logo de ${app.name}`}
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
          class="h-9 w-9 object-contain"
        />
      </span>
      <div class="min-w-0 flex-1">
        <h3 class="text-primary truncate text-xl font-bold">{app.name}</h3>
        <div class="mt-1.5 flex items-center justify-between gap-2">
          <Badge label={app.category} />
          <svg
            class="text-muted h-4 w-4 shrink-0 transition-transform duration-300 group-hover:rotate-180 group-has-[:checked]:rotate-180"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 8l5 5 5-5"></path>
          </svg>
        </div>
      </div>
    </header>

    <div class="relative mt-4 max-h-32 overflow-hidden transition-all duration-500 ease-in-out group-hover:max-h-96 peer-checked:max-h-96">
      <p class="text-primary text-base font-semibold leading-snug">{app.headline}</p>

      <p class="text-secondary mt-2 text-sm leading-relaxed">{app.description}</p>

      <div class="text-accent-primary mt-3 flex gap-2 text-sm font-semibold leading-snug">
        <span aria-hidden="true">▸</span>
        <p class="min-w-0">{app.keyFeature}</p>
      </div>

      <span
        class="from-card-light pointer-events-none absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t to-transparent opacity-100 transition-opacity duration-300 group-hover:opacity-0 peer-checked:opacity-0"
        aria-hidden="true"
      ></span>
    </div>

    <dl class="text-secondary border-border-subtle relative z-10 mt-auto space-y-2 border-t pt-4 text-sm">
      <div class="flex items-center justify-between gap-2">
        <dt class="font-semibold">Estado</dt>
        <dd>
          <span
            class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${statusToneClass[statusTone]}`}
          >
            {app.status}
          </span>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-2">
        <dt class="font-semibold">Plataforma</dt>
        <dd class="text-right break-words">{app.target}</dd>
      </div>
    </dl>

    <label for={toggleId} class="absolute inset-0 z-20 cursor-pointer" aria-hidden="true"></label>
  </article>
</div>
