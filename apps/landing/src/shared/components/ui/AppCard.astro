---
import Badge from '@/shared/components/ui/Badge.astro';
import type { Application } from '@/shared/types';

interface Props {
  app: Application;
}

type StatusTone = 'positive' | 'warning' | 'active';

const { app } = Astro.props;

const imageSrc = app.icon || app.logo;

const resolveStatusTone = (status: string): StatusTone => {
  const value = status.toLowerCase();
  if (value.includes('producc') || value.includes('disponible')) return 'positive';
  if (value.includes('beta')) return 'active';
  return 'warning';
};

const statusTone: StatusTone = resolveStatusTone(app.status);

const statusToneClass: Record<StatusTone, string> = {
  positive: 'bg-status-positive-bg text-status-positive-text',
  warning: 'bg-status-warning-bg text-status-warning-text',
  active: 'bg-status-active-bg text-status-active-text',
};
---

<div class="h-full min-h-[400px]">
  <article class="bg-card-light/60 border-border-subtle shadow-card flex h-full min-h-[400px] flex-col rounded-2xl border p-6 backdrop-blur-md">
    <header class="flex items-start gap-3">
      <span class="bg-surface-elevated border-border-subtle shadow-sm flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border">
        <img
          src={imageSrc}
          alt={`Logo de ${app.name}`}
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
          class="h-9 w-9 object-contain"
        />
      </span>
      <div class="min-w-0 flex-1">
        <h3 class="text-primary truncate text-xl font-bold">{app.name}</h3>
        <div class="mt-1.5">
          <Badge label={app.category} />
        </div>
      </div>
    </header>

    <div class="mt-4 flex-1">
      <p class="text-primary text-base font-semibold leading-snug">{app.headline}</p>

      <p class="text-secondary mt-2 text-sm leading-relaxed">{app.description}</p>

      <div class="text-accent-primary mt-3 flex gap-2 text-sm font-semibold leading-snug">
        <span aria-hidden="true">▸</span>
        <p class="min-w-0">{app.keyFeature}</p>
      </div>
    </div>

    <dl class="text-secondary border-border-subtle mt-4 space-y-2 border-t pt-4 text-sm">
      <div class="flex items-center justify-between gap-2">
        <dt class="font-semibold">Estado</dt>
        <dd>
          <span
            class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${statusToneClass[statusTone]}`}
          >
            {app.status}
          </span>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-2">
        <dt class="font-semibold">Plataforma</dt>
        <dd class="text-right break-words">{app.target}</dd>
      </div>
    </dl>
  </article>
</div>
