---
import { Image } from 'astro:assets';
import logo from '@/assets/branding-logo-fl.png';
import { navigation } from '@/shared/data/navigation';
import type { NavItem } from '@/shared/types';

interface Props {
  items?: NavItem[];
}

const { items = navigation } = Astro.props;
---

<header class="border-border-subtle/60 bg-card-light/70 sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href="/" aria-label="Foundly Labs" class="flex items-center bg-transparent">
      <Image src={logo} alt="Foundly Labs" loading="eager" class="h-10 w-auto" />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-secondary hover:text-accent-primary text-sm font-medium transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary class="text-primary cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-medium">
        Menú
      </summary>
      <ul class="bg-card-light border-border-subtle shadow-card absolute right-0 mt-2 w-48 space-y-1 rounded-xl border p-2">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-secondary hover:bg-badge-pill block rounded-lg px-3 py-2 text-sm"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>
