---
import '@/styles/global.css';
import '@fontsource-variable/inter';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Navbar from '@/shared/components/Navbar.astro';
import Footer from '@/shared/components/Footer.astro';
import SEO from '@/shared/components/SEO.astro';
import type { BaseLayoutProps } from '@/shared/types';

type Props = BaseLayoutProps;

const { title, description, image, canonical } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatinWoff2}
      crossorigin="anonymous"
    />
    <SEO title={title} description={description} image={image} canonicalURL={canonical} />
  </head>
  <body class="bg-app-body text-primary flex min-h-screen flex-col">
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
