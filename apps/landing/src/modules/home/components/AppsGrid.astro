---
import AppCard from '@/shared/components/ui/AppCard.astro';
import { apps } from '@/shared/data/apps';
---

<section id="apps" class="mx-auto max-w-7xl px-4 py-20">
  <h2 class="text-primary text-3xl font-bold tracking-tight sm:text-4xl">Nuestro Ecosistema</h2>
  <p class="text-secondary mt-3 max-w-2xl">
    Aplicaciones local-first diseñadas para comercio, finanzas y creación.
  </p>
  <div class="mt-10 grid grid-cols-1 items-start gap-6 md:grid-cols-2 lg:grid-cols-4">
    {apps.map((app) => (
      <AppCard app={app} />
    ))}
  </div>
</section>
