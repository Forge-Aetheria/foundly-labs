# Foundly API — environment (copy to .env; values are per-environment, never committed)
# See specs/architecture.md §3.1 and specs/book/008-api-integration-catalog-sync/contracts/api-connectivity.contract.md

# PostgreSQL (Supabase) — used by packages/database + apps/api
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (JWT verification, specs/api/008-supabase-jwt-auth)
SUPABASE_AUTH_URL=

# Subscription billing (specs/api/023-subscription-payments)
BILLING_PRO_AMOUNT_USD=
BILLING_PRO_DURATION_DAYS=30
BILLING_CHECKOUT_RETURN_URL=
BILLING_CHECKOUT_CANCEL_URL=
BILLING_MANUAL_BANK=
BILLING_MANUAL_CEDULA=
BILLING_MANUAL_PHONE=
BILLING_MANUAL_RATE_VES_PER_USD=
BILLING_MANUAL_NOTE=
PAYPAL_API_BASE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
BINANCE_PAY_API_BASE=
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_WEBHOOK_SECRET=
BILLING_ALERT_WEBHOOK_URL=

# API server port (default 3002)
PORT=3002

# CORS allowlist (comma-separated). Dev default: the Next.js book workspace.
# Production: https://foundly-book.vercel.app,https://book.foundlylabs.com (+ apex as needed)
CORS_ORIGINS=http://localhost:3001