{
  "name": "foundly-labs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @foundly/landing",
    "start": "npm run start -w @foundly/landing",
    "build": "npm run build -w @foundly/landing",
    "preview": "npm run preview -w @foundly/landing",
    "check": "npm run check -w @foundly/landing",
    "astro": "npm run astro -w @foundly/landing",
    "dev:landing": "npm run dev -w @foundly/landing",
    "build:landing": "npm run build -w @foundly/landing",
    "preview:landing": "npm run preview -w @foundly/landing",
    "check:landing": "npm run check -w @foundly/landing",
    "dev:book": "npm run dev -w @foundly/book --turbopack",
    "build:book": "npm run build -w @foundly/book",
    "start:book": "npm run start -w @foundly/book",
    "typecheck:book": "npm run typecheck -w @foundly/book",
    "test:book": "npm run test -w @foundly/book",
    "lint:book": "npm run lint -w @foundly/book",
    "codegen:book": "npm run codegen -w @foundly/book",
    "dev:api": "npm run dev -w @foundly/api",
    "build:api": "npm run build -w @foundly/api",
    "start:api": "npm run start -w @foundly/api",
    "typecheck:api": "npm run typecheck -w @foundly/api",
    "test:api": "npm run test -w @foundly/api",
    "lint:api": "npm run lint -w @foundly/api",
    "db:generate": "npm run db:generate -w @foundly/database",
    "db:migrate": "npm run db:migrate -w @foundly/database --",
    "db:push": "npm run db:push -w @foundly/database",
    "db:studio": "npm run db:studio -w @foundly/database",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
