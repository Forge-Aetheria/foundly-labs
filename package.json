{
  "name": "foundly-labs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "start": "pnpm --filter @foundly/landing start",
    "build": "turbo run build",
    "preview": "pnpm --filter @foundly/landing preview",
    "check": "pnpm --filter @foundly/landing check",
    "astro": "pnpm --filter @foundly/landing astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:landing": "pnpm --filter @foundly/landing dev",
    "build:landing": "pnpm --filter @foundly/landing build",
    "preview:landing": "pnpm --filter @foundly/landing preview",
    "check:landing": "pnpm --filter @foundly/landing check",
    "dev:book": "pnpm --filter @foundly/book dev --turbopack",
    "build:book": "pnpm --filter @foundly/book build",
    "start:book": "pnpm --filter @foundly/book start",
    "typecheck:book": "pnpm --filter @foundly/book typecheck",
    "test:book": "pnpm --filter @foundly/book test",
    "lint:book": "pnpm --filter @foundly/book lint",
    "codegen:book": "pnpm --filter @foundly/book codegen",
    "dev:api": "pnpm --filter @foundly/api dev",
    "build:api": "pnpm --filter @foundly/api build",
    "start:api": "pnpm --filter @foundly/api start",
    "typecheck:api": "pnpm --filter @foundly/api typecheck",
    "test:api": "pnpm --filter @foundly/api test",
    "lint:api": "pnpm --filter @foundly/api lint",
    "dev:mobile": "pnpm --filter @foundly/mobile dev",
    "build:mobile": "pnpm --filter @foundly/mobile build",
    "typecheck:mobile": "pnpm --filter @foundly/mobile typecheck",
    "test:mobile": "pnpm --filter @foundly/mobile test",
    "lint:mobile": "pnpm --filter @foundly/mobile lint",
    "codegen:mobile": "pnpm --filter @foundly/mobile codegen",
    "db:generate": "pnpm --filter @foundly/database db:generate",
    "db:migrate": "pnpm --filter @foundly/database db:migrate --",
    "db:push": "pnpm --filter @foundly/database db:push",
    "db:studio": "pnpm --filter @foundly/database db:studio",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  }
}
