# Foundly Database — Prisma CLI environment (copy to .env; values are per-environment, never committed)
# See README.md §"Connection string" and specs/architecture.md §3.1.
#
# The Prisma CLI (`db:push`, `db:migrate`, `db:studio`, `db:generate`) runs from
# `packages/database` and reads these two variables. They must match the values
# used by the running API (`apps/api/.env`).

# Runtime connection (Supabase pooler, port 6543, pgbouncer=true).
DATABASE_URL=

# Direct connection used by the Prisma CLI for migrations/introspection
# (Supabase direct, port 5432). Without it the CLI fails with P1012.
DIRECT_URL=
