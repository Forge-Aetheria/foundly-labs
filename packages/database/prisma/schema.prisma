// Foundly — DB-First schema (Prisma + PostgreSQL)
// Booking reservation models mirror the domain designed in apps/book for 1:1 mapping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                    String              @id @default(cuid())
  name                  String
  category              String
  status                String              @default("active")
  plan                  String?
  subscriptionPlan      SubscriptionPlan    @default(FREE)
  subscriptionStatus    SubscriptionStatus  @default(active)
  subscriptionExpiresAt DateTime?
  timezone              String
  currency              String              @default("EUR")
  isPublic              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  profile       BusinessProfile?
  services      Service[]
  specialists   Specialist[]
  appointments  Appointment[]
  gallery       GalleryPhoto[]
  availability  Availability[]
  reviews       Review[]
  timeBlocks    TimeBlock[]
  paymentMethods PaymentMethod[]
  notifications  AppointmentNotification[]
  inbox          Notification[]
  pushTokens     PushDeviceToken[]
}

model BusinessProfile {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  slug        String   @unique
  bio         String?
  address     String?
  phone       String?
  instagram   String?
  whatsapp    String?
  logo        String?
  cover       String?
  brandColors Json?
  policies    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  category        String?
  priceCents      Int
  currency        String   @default("EUR")
  active          Boolean  @default(true)
  requiresAdvance Boolean  @default(false)
  advanceKind     AdvanceKind?
  advanceValue    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  assignments  SpecialistService[]
  appointments Appointment[]
}

model Specialist {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  role      String?
  avatar    String?
  bio       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  assignments  SpecialistService[]
  appointments Appointment[]
  availability Availability[]
  timeBlocks   TimeBlock[]
}

model SpecialistService {
  specialistId String
  serviceId    String

  specialist Specialist @relation(fields: [specialistId], references: [id])
  service    Service    @relation(fields: [serviceId], references: [id])

  @@id([specialistId, serviceId])
}

model Availability {
  id                     String   @id @default(cuid())
  tenantId               String
  specialistId           String?
  weekday                Int
  startTime              String
  endTime                String
  slotGranularityMinutes Int      @default(30)
  minLeadTimeMinutes     Int      @default(0)
  bookingHorizonDays     Int      @default(60)
  breaks                 Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  specialist Specialist? @relation(fields: [specialistId], references: [id])
}

model Appointment {
  id                     String   @id @default(cuid())
  tenantId               String
  specialistId           String
  serviceId              String
  clientName             String
  clientContact          String?
  startAt                DateTime
  endAt                  DateTime
  status                 String   @default("pending")
  appliedDurationMinutes Int
  appliedAmountCents     Int
  appliedCurrency        String   @default("EUR")
  origin                 String   @default("online")
  notes                  String?
  cancellationReason     String?
  paymentMethodType      PaymentMethodType?
  advanceAmountCents     Int?
  paymentReference       String?
  paymentProofUrl        String?
  paymentSubmittedAt     DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  specialist    Specialist              @relation(fields: [specialistId], references: [id])
  service       Service                 @relation(fields: [serviceId], references: [id])
  notifications AppointmentNotification[]
}

model GalleryPhoto {
  id          String   @id @default(cuid())
  tenantId    String
  url         String
  title       String?
  description String?
  category    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

enum ReviewState {
  pending
  approved
  rejected
}

model Review {
  id        String      @id @default(cuid())
  tenantId  String
  author    String
  rating    Int
  comment   String
  state     ReviewState @default(pending)
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, state])
}

model TimeBlock {
  id           String   @id @default(cuid())
  tenantId     String
  specialistId String?
  startAt      DateTime
  endAt        DateTime
  reason       String?
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  specialist Specialist? @relation(fields: [specialistId], references: [id])

  @@index([tenantId, startAt])
}

enum PaymentMethodType {
  pago_movil
  binance
  zelle
  transfer
  cash
}

enum AdvanceKind {
  fixed
  percent
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  active
  past_due
  expired
  canceled
}

model PaymentMethod {
  id           String            @id @default(cuid())
  tenantId     String
  type         PaymentMethodType
  label        String?
  details      String?
  instructions String?
  active       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
  @@index([tenantId, active])
}

model AppointmentNotification {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  kind          String
  message       String
  channel       String   @default("simulated")
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

/// Central in-app notification inbox type (closed set).
enum NotificationType {
  NEW_BOOKING
  RESCHEDULE_REQUEST
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  SYSTEM_INFO
}

/// Central tenant-scoped notification shown in the admin inbox.
model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, read])
}


enum PushPlatform {
  IOS
  ANDROID
}

model PushDeviceToken {
  id         String       @id @default(cuid())
  tenantId   String
  userId     String
  token      String       @unique
  platform   PushPlatform
  deviceId   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lastSeenAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
